<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.scholarship.controller.ResultsController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>
    <Label fx:id="headerLabel" styleClass="title" text="Matching Scholarships"/>

    <TableView fx:id="scholarshipTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Scholarship" prefWidth="220"/>
            <TableColumn fx:id="providerColumn" text="Provider" prefWidth="180"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
            <TableColumn fx:id="deadlineColumn" text="Deadline" prefWidth="120"/>
        </columns>
    </TableView>

    <TextArea fx:id="detailArea" editable="false" promptText="Select a scholarship to see details" prefRowCount="4"/>

    <Button onAction="#handleBack" text="Back to Profile"/>
</VBox>
